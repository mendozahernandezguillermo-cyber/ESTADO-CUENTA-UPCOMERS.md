# Copia este fichero a .env y rellena los valores. NUNCA subas .env a git.

# --- Token de las 3 APIs de datos DARWIN (validez ~6 meses) ---
# Se genera en: https://www.darwinex.com/data/darwin-api
DARWINEX_ACCESS_TOKEN=

# Solo necesarios si algun dia usas el flujo de refresh token (no hace falta para datos)
DARWINEX_CONSUMER_KEY=
DARWINEX_CONSUMER_SECRET=
DARWINEX_REFRESH_TOKEN=

# --- Nombre largo del producto ---
# Sacalo de la URL del perfil: https://www.darwinex.com/darwin/THL.4.XX
DARWIN_TICKER=THL
DARWIN_PRODUCT=THL.4.XX

# --- FTP de Raw DARWIN Data (CREDENCIALES DISTINTAS del token) ---
# Da acceso a las ~30 series por DARWIN, incluidas las de nivel trade.
# Hay que solicitarlas a Darwinex (info@darwinex.com) si no las tienes.
DARWIN_FTP_USER=
DARWIN_FTP_PASS=
DARWIN_FTP_HOST=
DARWIN_FTP_PORT=21
